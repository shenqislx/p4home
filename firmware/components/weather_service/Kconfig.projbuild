menu "P4Home Weather Service"

config P4HOME_WEATHER_ENABLE
    bool "Fetch public weather data for dashboard"
    default y

config P4HOME_WEATHER_LATITUDE
    string "Weather latitude"
    default "31.2304"

config P4HOME_WEATHER_LONGITUDE
    string "Weather longitude"
    default "121.4737"

config P4HOME_WEATHER_TIMEZONE
    string "Weather timezone"
    default "Asia/Shanghai"

config P4HOME_WEATHER_USE_TLS
    bool "Use HTTPS for public weather API"
    default n
    help
        Keep this disabled for field validation on networks where SNTP or TLS
        handshakes are unreliable. Enable it when public Internet time sync is
        stable and certificate validation is desired.

config P4HOME_WEATHER_REFRESH_MS
    int "Weather refresh interval (ms)"
    range 300000 86400000
    default 1800000

config P4HOME_WEATHER_CONNECT_TIMEOUT_MS
    int "Weather HTTP timeout (ms)"
    range 1000 30000
    default 7000

config P4HOME_WEATHER_HTTP_MAX_BYTES
    int "Weather HTTP max response bytes"
    range 2048 32768
    default 8192

config P4HOME_WEATHER_PANEL_ENTITY_ID
    string "Dashboard weather entity id"
    default "weather.forecast_wo_de_jia"

endmenu

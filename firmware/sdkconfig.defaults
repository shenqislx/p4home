# Align defaults with the ESP32-P4 EVB baseline so the custom partition table fits.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# Phase 0 hardware baseline left only 660 B on the 3584 B main task. Keep
# enough margin for diagnostics and the future Agent bootstrap path.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120
CONFIG_P4HOME_AGENT_TRANSPORT_TASK_STACK=12288
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_FONT_UNSCII_16=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=n
# 96 KB internal + 64 KB PSRAM overflow. Raised from 64 KB after display_service
# stopped allocating the unused 100 KB software-rotation buffer; the pixel home
# page needs the extra headroom for lv_snapshot and for the transform scratch the
# 4x nearest-neighbour sprite path uses.
CONFIG_LV_MEM_SIZE_KILOBYTES=96
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=64
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_MAX_CERTS=64
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_BSP_LCD_TYPE_1024_600=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
# ESP-Hosted SDIO packets do not need to consume the P4's scarce internal DMA
# heap after the bus transfer. 2.12.8+ can keep its bounded transport pool in
# PSRAM, leaving internal memory available for concurrent ESP-SR capture.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
# ESP32-P4 SDMMC DMA requires the ESP-Hosted PSRAM pool blocks to remain aligned
# to the 64-byte L2 cache line. A stale private 128-byte selection can make the
# 1600-byte transport stride alternate between aligned and invalid addresses.
CONFIG_CACHE_L2_CACHE_LINE_64B=y
# CONFIG_CACHE_L2_CACHE_LINE_128B is not set
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_RX_BA_WIN=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_P4HOME_SR_ENABLE=n
CONFIG_P4HOME_AUDIO_STARTUP_SELFTEST=n
CONFIG_P4HOME_PHASE5A_VALIDATION=n
CONFIG_P4HOME_PHASE5B_VALIDATION=n
CONFIG_P4HOME_VOICE_TRANSPORT_ENABLED=n
CONFIG_P4HOME_GATEWAY_RUNTIME_POLL_ENABLE=n
CONFIG_P4HOME_WIFI_MODEM_SLEEP_ENABLE=y
CONFIG_P4HOME_HA_CLIENT_WORKER_STACK=12288
CONFIG_P4HOME_HA_CLIENT_WS_TASK_STACK=8192
CONFIG_P4HOME_HA_CLIENT_MAX_INITIAL_ENTITIES=48
CONFIG_P4HOME_PANEL_STORE_HISTORY_POINTS=12
CONFIG_P4HOME_PANEL_STORE_SAMPLE_INTERVAL_MS=3600000
CONFIG_P4HOME_PANEL_STORE_MAX_ENTITIES=48
CONFIG_P4HOME_ENTITY_WHITELIST_MAX_ENTITIES=48
CONFIG_P4HOME_PHASE4C_VALIDATION=n
CONFIG_P4HOME_WEATHER_ENABLE=y
CONFIG_P4HOME_WEATHER_LATITUDE="31.2304"
CONFIG_P4HOME_WEATHER_LONGITUDE="121.4737"
CONFIG_P4HOME_WEATHER_TIMEZONE="Asia/Shanghai"
CONFIG_P4HOME_WEATHER_USE_TLS=n
CONFIG_P4HOME_WEATHER_REFRESH_MS=1800000

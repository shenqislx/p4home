{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p4home://contracts/home-assistant/v1/policy.schema.json",
  "title": "P4 Home Robot Home Assistant Policy v1",
  "type": "object",
  "required": ["schema_version", "policy_id", "entities"],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["alias", "entity_id", "domain", "read", "write_actions", "projected_attributes"],
      "properties": {
        "alias": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "entity_id": {
          "type": "string",
          "pattern": "^(light|switch|scene|climate|sensor|binary_sensor)\\.[a-z0-9_]+$",
          "maxLength": 128
        },
        "domain": { "enum": ["light", "switch", "scene", "climate", "sensor", "binary_sensor"] },
        "read": { "const": true },
        "write_actions": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["turn_on", "turn_off", "activate_scene"] }
        },
        "projected_attributes": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "brightness",
              "color_temp_kelvin",
              "current_temperature",
              "temperature",
              "hvac_action",
              "unit_of_measurement",
              "device_class"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}

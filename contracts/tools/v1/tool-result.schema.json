{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4home.local/contracts/tools/v1/tool-result.schema.json",
  "title": "P4 Tool Result v1",
  "type": "object",
  "required": ["schema_version", "tool_call_id", "name", "status", "result", "error"],
  "properties": {
    "schema_version": { "const": 1 },
    "tool_call_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": {
      "enum": ["character.get_state", "character.go_to_room", "character.set_activity", "character.say", "world.get_snapshot"]
    },
    "status": { "enum": ["success", "error"] },
    "result": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {
              "enum": ["INVALID_ARGUMENT", "UNSUPPORTED_TOOL", "UNKNOWN_ROOM", "DEVICE_OFFLINE", "QUEUE_FULL", "DEADLINE_EXCEEDED", "CANCELLED", "DEVICE_BUSY", "ACTION_ID_CONFLICT", "INTERNAL"]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 256 },
            "retryable": { "type": "boolean" },
            "details": { "type": "object" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "roomId": { "enum": ["primary_bedroom", "study", "guest_room", "entry", "living_room", "kitchen"] },
    "activity": { "enum": ["idle", "sleep"] },
    "characterState": {
      "type": "object",
      "required": ["room_id", "activity", "speaking", "active_action_id"],
      "properties": {
        "room_id": { "$ref": "#/$defs/roomId" },
        "activity": { "$ref": "#/$defs/activity" },
        "speaking": { "type": "boolean" },
        "active_action_id": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "goToRoomResult": {
      "type": "object",
      "required": ["room_id"],
      "properties": { "room_id": { "$ref": "#/$defs/roomId" } },
      "additionalProperties": false
    },
    "setActivityResult": {
      "type": "object",
      "required": ["activity"],
      "properties": { "activity": { "$ref": "#/$defs/activity" } },
      "additionalProperties": false
    },
    "sayResult": {
      "type": "object",
      "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 256 } },
      "additionalProperties": false
    },
    "worldSnapshotResult": {
      "type": "object",
      "required": ["state_version", "observed_at_ms", "character"],
      "properties": {
        "state_version": { "type": "integer", "minimum": 0 },
        "observed_at_ms": { "type": "integer", "minimum": 0 },
        "character": { "$ref": "#/$defs/characterState" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
      "then": { "properties": { "result": { "type": "object" }, "error": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
      "then": { "properties": { "result": { "type": "null" }, "error": { "type": "object" } } }
    },
    {
      "if": { "properties": { "status": { "const": "success" }, "name": { "const": "character.get_state" } }, "required": ["status", "name"] },
      "then": { "properties": { "result": { "$ref": "#/$defs/characterState" } } }
    },
    {
      "if": { "properties": { "status": { "const": "success" }, "name": { "const": "character.go_to_room" } }, "required": ["status", "name"] },
      "then": { "properties": { "result": { "$ref": "#/$defs/goToRoomResult" } } }
    },
    {
      "if": { "properties": { "status": { "const": "success" }, "name": { "const": "character.set_activity" } }, "required": ["status", "name"] },
      "then": { "properties": { "result": { "$ref": "#/$defs/setActivityResult" } } }
    },
    {
      "if": { "properties": { "status": { "const": "success" }, "name": { "const": "character.say" } }, "required": ["status", "name"] },
      "then": { "properties": { "result": { "$ref": "#/$defs/sayResult" } } }
    },
    {
      "if": { "properties": { "status": { "const": "success" }, "name": { "const": "world.get_snapshot" } }, "required": ["status", "name"] },
      "then": { "properties": { "result": { "$ref": "#/$defs/worldSnapshotResult" } } }
    }
  ],
  "additionalProperties": false
}
